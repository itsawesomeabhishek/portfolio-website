# ==============================================================================
# Environment Configuration Template for Abhishek's Portfolio & Admin Panel
# Copy this file to .env.local and populate with your live credentials
# ==============================================================================

# 1. Supabase PostgreSQL Configuration
# Found at: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 2. Cloudinary Media Upload Pipeline (Image & PDF CDN)
# Found at: Cloudinary Dashboard -> API Keys
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="abcdefghijklmnopqrstuvwxyz12345"

# 3. Admin Authentication & Session
# Set your desired admin login credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="YourSecurePassword123!"
JWT_SECRET="generate-a-secure-random-secret-key-at-least-32-characters-long"
