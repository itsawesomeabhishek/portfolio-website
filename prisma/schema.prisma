datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Admin Auth ──────────────────────────────────────────
model Admin {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  name           String   @default("Abhishek")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── Identity / Hero / About ─────────────────────────────
model Identity {
  id               String   @id @default("singleton")
  name             String
  handle           String
  logo             String
  headlineSolid    String
  headlineOutlined String
  heroStatus       String
  roleBannerIntro  String
  roleBannerSkills String
  terminalTitle    String
  whoami           String[]
  location         String
  status           String
  bio              String[]
  avatar           String
  resume           String
  siteUrl          String
  description      String
  copyrightYear    Int
  updatedAt        DateTime @updatedAt
}

// ─── Tech Stack ──────────────────────────────────────────
model StackNode {
  id        String   @id @default(cuid())
  label     String
  tech      String
  icon      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── Projects ────────────────────────────────────────────
model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  tags        String[]
  image       String
  alt         String
  live        String?
  github      String?
  placeholder Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Services ────────────────────────────────────────────
model Service {
  id        String   @id @default(cuid())
  title     String
  summary   String
  points    String[]
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── Stats ───────────────────────────────────────────────
model StatCard {
  id        String   @id @default(cuid())
  label     String
  value     String
  note      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── Education ───────────────────────────────────────────
model Education {
  id        String   @id @default("singleton")
  school    String
  degree    String
  start     String
  end       String
  facts     String[]
  updatedAt DateTime @updatedAt
}

// ─── Certificates ────────────────────────────────────────
model Certificate {
  id        String   @id @default(cuid())
  title     String
  issuer    String
  date      String
  image     String
  alt       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── Quotes ──────────────────────────────────────────────
model Quote {
  id        String   @id @default(cuid())
  text      String
  author    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── Contact & Socials ───────────────────────────────────
model ContactInfo {
  id        String   @id @default("singleton")
  email     String
  updatedAt DateTime @updatedAt
}

model Social {
  id        String   @id @default(cuid())
  label     String
  href      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── Navigation ──────────────────────────────────────────
model NavLink {
  id        String   @id @default(cuid())
  label     String
  href      String
  sortOrder Int      @default(0)
}

// ─── Site Config ─────────────────────────────────────────
model SiteConfig {
  id            String   @id @default("singleton")
  githubProfile String
  updatedAt     DateTime @updatedAt
}
